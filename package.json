{
  "name": "okolos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only OR LicenseRef-PassionCode-Commercial",
  "description": "Browser security for the age of AI agents — local-first, verifiable.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/passioncode-ai/okolos.git"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "test:e2e": "pnpm build && pnpm build:e2e && playwright test",
    "lint": "eslint .",
    "ux:lint": "node tools/python.mjs docs/ux/lint.py",
    "brand:lint": "node tools/brand-gate.mjs",
    "gates": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm ux:lint && pnpm brand:lint && pnpm i18n:sweep && pnpm package:check",
    "build:e2e": "node tools/build.mjs --with-test-hooks",
    "test:e2e:firefox": "pnpm build && pnpm build:e2e && node tools/firefox-e2e.mjs && playwright test -c playwright.gecko.config.ts && node tools/gecko-layout.mjs",
    "wireframes": "node tools/wireframes.mjs",
    "public:style": "node tools/public-style.mjs",
    "graph:check": "node tools/graph-check.mjs",
    "suffix:gap": "node tools/suffix-gap.mjs",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "package": "node tools/package.mjs",
    "package:check": "node tools/package.mjs --check",
    "screenshots": "node tools/build.mjs --store-shots && node tools/screenshots.mjs",
    "access:list": "node tools/access.mjs",
    "access:check": "node tools/access.mjs --check",
    "i18n:sweep": "node tools/i18n-sweep.mjs",
    "feed:ingest": "node tools/ingest.mjs",
    "feed:refresh": "node tools/feed-job.mjs",
    "feed:agent": "node tools/install-feed-agent.mjs",
    "feed:snapshot": "node tools/feed-snapshot.mjs",
    "agent:build": "node tools/build-agent.mjs",
    "agent:install": "node tools/install-agent.mjs",
    "agent:doctor": "node apps/agent/dist/bin/okolos-agent.mjs doctor"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.18.0",
    "@types/selenium-webdriver": "^4.35.7",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "geckodriver": "^8.0.0",
    "happy-dom": "^21.0.4",
    "selenium-webdriver": "^4.53.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
