{
  "name": "okolos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only OR LicenseRef-PassionCode-Commercial",
  "description": "Browser security for the age of AI agents — local-first, verifiable.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/passioncode-ai/okolos.git"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "test:e2e": "pnpm build && pnpm build:e2e && playwright test",
    "lint": "eslint .",
    "ux:lint": "python3 docs/ux/lint.py",
    "brand:lint": "node tools/brand-gate.mjs",
    "gates": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm ux:lint && pnpm brand:lint && pnpm i18n:sweep && pnpm package:check",
    "build:e2e": "node tools/build.mjs --with-test-hooks",
    "test:e2e:firefox": "pnpm build && node tools/firefox-e2e.mjs && node tools/gecko-layout.mjs",
    "wireframes": "node tools/wireframes.mjs",
    "public:style": "node tools/public-style.mjs",
    "graph:check": "node tools/graph-check.mjs",
    "suffix:gap": "node tools/suffix-gap.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "package": "node tools/package.mjs",
    "package:check": "node tools/package.mjs --check",
    "screenshots": "pnpm build && node tools/screenshots.mjs",
    "access:list": "node tools/access.mjs",
    "access:check": "node tools/access.mjs --check",
    "i18n:sweep": "node tools/i18n-sweep.mjs",
    "feed:ingest": "node tools/ingest.mjs",
    "feed:refresh": "node tools/feed-job.mjs",
    "feed:agent": "node tools/install-feed-agent.mjs",
    "feed:snapshot": "node tools/feed-snapshot.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.57.0",
    "@types/chrome": "^0.1.32",
    "@types/node": "^22.18.0",
    "@types/selenium-webdriver": "^4.35.6",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.2",
    "fast-check": "^4.3.0",
    "geckodriver": "^6.1.1",
    "happy-dom": "^20.0.0",
    "selenium-webdriver": "^4.46.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
