#!/bin/sh
# Reading the gate output before pushing — as a mechanism rather than a rule.
#
# Standing instruction 5 says exactly this, and on 2026-08-07 a commit went out
# red anyway: `pnpm test` exited 1, the command was chained past it, and the
# exit code was read after the push. The instruction lives in a document; the
# push lives in a shell. Only one of those can stop the other.
#
# Escape hatch: OKOLOS_SKIP_GATES=1 git push. Deliberately not --no-verify,
# which skips this file silently and leaves no trace of what was not checked.

set -e

if [ -n "$OKOLOS_SKIP_GATES" ]; then
    echo "pre-push: SKIPPED by OKOLOS_SKIP_GATES — lint, typecheck, unit and ux were not run."
    echo "pre-push: whatever is being pushed has not been checked by this machine."
    exit 0
fi

# What is being pushed. Git writes one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# The gates check code, so they run when a branch or a tag receives content.
# A lease is a ref under refs/agent-sync/leases/ (docs/AGENT_SYNC.md): taking or
# releasing one pushed only that ref, yet ran all eight gates — minutes per
# lease, and a lease taken for a two-line edit outlived the edit (2026-10-06).
# Deleting a branch carries no content either. No stdin at all is a hand run,
# and a hand run checks everything.
zero=0000000000000000000000000000000000000000
lines=0
content=0
if [ ! -t 0 ]; then
    while read -r _local_ref local_sha remote_ref _remote_sha; do
        [ -n "$remote_ref" ] || continue
        lines=$((lines + 1))
        case "$remote_ref" in
            refs/heads/*|refs/tags/*)
                [ "$local_sha" = "$zero" ] || content=1 ;;
        esac
    done
fi
if [ "$lines" -gt 0 ] && [ "$content" -eq 0 ]; then
    decision=skip
else
    decision=gates
fi
if [ -n "$OKOLOS_PREPUSH_DECIDE" ]; then
    # Prints the decision and stops: lets tools/ci.test.ts check the rule above
    # without running eight gates per case.
    echo "$decision"
    exit 0
fi
if [ "$decision" = skip ]; then
    echo "pre-push: no branch or tag receives content (lease refs or deletions only) — gates not needed."
    exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

fail=0
run() {
    printf 'pre-push: %-12s' "$1"
    if out=$(eval "$2" 2>&1); then
        echo 'ok'
    else
        echo 'FAILED'
        # The output, not a summary of it: a gate that says only "failed" sends
        # the reader back to re-run it, which is the moment the hook gets skipped.
        echo "$out" | tail -25 | sed 's/^/           /'
        fail=1
    fi
}

run lint      'pnpm -s run lint'
run typecheck 'pnpm -s run typecheck'
# Before the unit step, not after it: part of that suite reads `dist/` — the
# bundle scanners — so without a build they scan whatever was lying around.
# That is how three defects reproduced against a stale emit minutes after the
# source was green (B-36).
run build     'pnpm -s run build'
run unit      'pnpm -s run test'
run ux        'python3 docs/ux/lint.py'
run brand     'node tools/brand-gate.mjs'
run i18n      'node tools/i18n-sweep.mjs'
# After the build, for the same reason the unit step is: it reads what `dist/`
# contains. CI ran this and the local chain did not, so `pnpm gates` returned
# green on a tree CI could still redden (2026-08-21).
run package   'node tools/package.mjs --check'

if [ "$fail" -ne 0 ]; then
    echo
    echo 'pre-push: refusing to push. Fix the above, or OKOLOS_SKIP_GATES=1 git push to override.'
    exit 1
fi
