      "name": "nesting",
      "body": "<section><div><p>a</p><p style=\"display:none\">b</p></div><div><p style=\"opacity:0\">c</p></div></section>"
    },
    {
      "name": "head",
      "body": "<p>body</p>",
      "head": "<title>Tab</title><meta name=\"description\" content=\"meta text\">"
